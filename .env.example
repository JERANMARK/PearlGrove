# Frontend Environment Variables
VITE_API_URL=https://your-render-backend-url.onrender.com/api
VITE_WHATSAPP_NUMBER=94715498142

# Backend Environment Variables
# Backend values can be supplied through the process environment or backend/.env locally.
# For deployment, set them in your hosting platform's env panel.
DATABASE_URL="mysql://your_db_user:your_db_password@your_db_host:3306/pearl_grow"
PORT=10000
NODE_ENV=production
# Set a random secret of at least 32 bytes in the environment; never commit it.
JWT_SECRET=
FRONTEND_URL="https://your-vercel-app-url.vercel.app"
WHATSAPP_NUMBER="94715498142"
# Comma-separated explicit local browser origins; used only outside production.
DEV_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
# ADMIN_EMAIL and ADMIN_PASSWORD are needed only for one-time CLI provisioning.
