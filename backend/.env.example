# Backend local development template. Replace placeholders in the process environment or an ignored backend/.env file.
DATABASE_URL="mysql://<db_user>:<db_password>@localhost:3306/<database_name>"
PORT=5000
NODE_ENV=development
JWT_SECRET=<generate-a-random-secret-with-at-least-32-bytes>
FRONTEND_URL=http://localhost:5173
DEV_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
WHATSAPP_NUMBER=<international-number-without-plus>
# Production uploads require a persistent mount and the public origin of the API.
UPLOADS_DIR=
PUBLIC_API_URL=